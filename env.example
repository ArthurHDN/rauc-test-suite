# Copy to ".env" (git-ignored) and fill in. Values from the process environment win over this file.
# Do not put comments after a value; quote values containing spaces or '#'.
# The former JETSON_* names are still accepted (TARGET_HOST = JETSON_HOST, ...).

# --- required ---------------------------------------------------------------
# Device under test = Yocto MACHINE name. Supported (see ./run_tests.py --list-devices):
#   jetson-orin-nano-devkit-nvme | jetson-orin-nano-devkit | raspberrypi4-64
DEVICE=jetson-orin-nano-devkit-nvme
TARGET_HOST=192.168.1.50

# --- optional ---------------------------------------------------------------
TARGET_USER=root
# Leave empty (or remove the line) for an EMPTY password, e.g. images built with debug-tweaks.
TARGET_PASSWORD=
TARGET_PORT=22
# Private key tried before the password.
TARGET_KEY_FILE=
TARGET_KEY_PASSPHRASE=
TARGET_CONNECT_TIMEOUT=15

# Host command that power-cycles the device (smart plug, relay, ...). Used when the target does
# not come back after TARGET_POWER_CYCLE_AFTER seconds (needed for the boot-failure fallback test
# TC-6.6, always on the Raspberry Pi where a broken boot hangs). It is repeated every
# TARGET_POWER_CYCLE_AFTER seconds while the device stays away; the Raspberry Pi needs 3 cycles
# (3 boot attempts) before it falls back, so use a value a bit above its normal boot time, e.g. 120.
TARGET_POWER_CYCLE_CMD=
TARGET_POWER_CYCLE_AFTER=300
